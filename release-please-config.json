{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "package-name": "sphinx-java-autodoc",
      "extra-files": [
        "src/sphinx_java_autodoc/extractor.py",
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='sphinx-java-autodoc')].version"
        }
      ]
    }
  }
}
